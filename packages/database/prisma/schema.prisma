generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum CustomerContactStatus {
  ACTIVE
  ARCHIVED
}

enum AddressType {
  BILLING
  SHIPPING
  OTHER
}

enum OrganizationSequenceType {
  CUSTOMER
  SUBSCRIPTION
  QUOTATION
  INVOICE
  PAYMENT
  REFUND
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  VOIDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  UPI
  CASH
  OTHER
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  VOIDED
}

enum RuleStatus {
  ACTIVE
  ARCHIVED
}

enum QuotationStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  CLOSED
}

enum SubscriptionAmendmentType {
  PAUSED
  RESUMED
  CANCELLED
}

enum ProductType {
  GOODS
  SERVICE
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PlanPriceStatus {
  ACTIVE
  ARCHIVED
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  resource        String           @db.VarChar(64)
  action          String           @db.VarChar(64)
  code            String           @unique @db.VarChar(128)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Organization {
  id                  String                     @id @default(uuid()) @db.Uuid
  name                String                     @db.VarChar(160)
  slug                String                     @unique @db.VarChar(80)
  defaultCurrencyCode String                     @default("INR") @map("default_currency_code") @db.Char(3)
  timezone            String                     @default("Asia/Kolkata") @db.VarChar(64)
  status              OrganizationStatus         @default(ACTIVE)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships         OrganizationMembership[]
  roles               Role[]
  customers           Customer[]
  sequences           OrganizationSequence[]
  products            Product[]
  plans               Plan[]
  subscriptions       Subscription[]
  quotations          Quotation[]
  invoices            Invoice[]
  payments            Payment[]
  refunds             Refund[]
  taxes               Tax[]
  discounts           Discount[]

  @@map("organizations")
}

model User {
  id           String                     @id @default(uuid()) @db.Uuid
  email        String                     @unique @db.VarChar(320)
  passwordHash String                     @map("password_hash")
  firstName    String                     @map("first_name") @db.VarChar(100)
  lastName     String                     @map("last_name") @db.VarChar(100)
  status       UserStatus                 @default(INVITED)
  lastLoginAt  DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships  OrganizationMembership[]

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  name            String           @db.VarChar(100)
  code            String           @db.VarChar(100)
  description     String?          @db.VarChar(255)
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships     MembershipRole[]
  permissions     RolePermission[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("roles")
}

model MembershipRole {
  organizationId String                  @map("organization_id") @db.Uuid
  membershipId   String                  @map("membership_id") @db.Uuid
  roleId         String                  @map("role_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  membership     OrganizationMembership  @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  role           Role                    @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([organizationId, membershipId])
  @@map("membership_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OrganizationSequence {
  organizationId String                   @map("organization_id") @db.Uuid
  sequenceType   OrganizationSequenceType @map("sequence_type")
  nextValue      BigInt                   @default(0) @map("next_value")
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, sequenceType])
  @@map("organization_sequences")
}

model Customer {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  customerNumber      String         @map("customer_number") @db.VarChar(64)
  customerType        CustomerType   @map("customer_type")
  legalName           String         @map("legal_name") @db.VarChar(160)
  displayName         String         @map("display_name") @db.VarChar(160)
  email               String?        @db.VarChar(320)
  phone               String?        @db.VarChar(40)
  taxIdentifier       String?        @map("tax_identifier") @db.VarChar(100)
  defaultCurrencyCode String         @map("default_currency_code") @db.Char(3)
  status              CustomerStatus @default(ACTIVE)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts            CustomerContact[]
  addresses           CustomerAddress[]
  subscriptions       Subscription[]
  quotations          Quotation[]
  invoices            Invoice[]

  @@unique([organizationId, customerNumber])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@map("customers")
}

model CustomerContact {
  id          String                @id @default(uuid()) @db.Uuid
  customerId  String                @map("customer_id") @db.Uuid
  firstName   String                @map("first_name") @db.VarChar(100)
  lastName    String                @map("last_name") @db.VarChar(100)
  email       String?               @db.VarChar(320)
  phone       String?               @db.VarChar(40)
  jobTitle    String?               @map("job_title") @db.VarChar(100)
  isPrimary   Boolean               @default(false) @map("is_primary")
  status      CustomerContactStatus @default(ACTIVE)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, status])
  @@map("customer_contacts")
}

model CustomerAddress {
  id          String      @id @default(uuid()) @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  addressType AddressType @map("address_type")
  addressLine1 String     @map("address_line_1") @db.VarChar(160)
  addressLine2 String?    @map("address_line_2") @db.VarChar(160)
  city        String      @db.VarChar(100)
  state       String?     @db.VarChar(100)
  postalCode  String?     @map("postal_code") @db.VarChar(32)
  countryCode String      @map("country_code") @db.Char(2)
  isDefault   Boolean     @default(false) @map("is_default")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, addressType])
  @@map("customer_addresses")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  productCode      String        @map("product_code") @db.VarChar(64)
  name             String        @db.VarChar(160)
  description      String?       @db.VarChar(2000)
  productType      ProductType   @map("product_type")
  costPrice        Decimal       @default(0) @map("cost_price") @db.Decimal(19, 4)
  costCurrencyCode String        @map("cost_currency_code") @db.Char(3)
  status           ProductStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  attributes       ProductAttribute[]
  planItems        PlanItem[]

  @@unique([organizationId, productCode])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@map("products")
}

model ProductVariant {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  sku            String        @db.VarChar(100)
  name           String        @db.VarChar(160)
  description    String?       @db.VarChar(2000)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  product        Product       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  attributeValues ProductVariantAttributeValue[]
  planItems       PlanItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, id])
  @@index([organizationId, productId, status])
  @@map("product_variants")
}

model ProductAttribute {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  name           String        @db.VarChar(100)
  code           String        @db.VarChar(64)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  product        Product       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  values         ProductAttributeValue[]

  @@unique([productId, code])
  @@unique([organizationId, id])
  @@index([organizationId, productId])
  @@map("product_attributes")
}

model ProductAttributeValue {
  id                String                         @id @default(uuid()) @db.Uuid
  attributeId       String                         @map("attribute_id") @db.Uuid
  value             String                         @db.VarChar(100)
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  attribute         ProductAttribute               @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  variantAttributes ProductVariantAttributeValue[]

  @@unique([attributeId, value])
  @@map("product_attribute_values")
}

model ProductVariantAttributeValue {
  variantId        String                @map("variant_id") @db.Uuid
  attributeValueId String                @map("attribute_value_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  variant          ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  attributeValue   ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@map("product_variant_attribute_values")
}

model Plan {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  planCode String @map("plan_code") @db.VarChar(64)
  name String @db.VarChar(160)
  description String? @db.VarChar(2000)
  status PlanStatus @default(ACTIVE)
  minimumQuantity Int @default(1) @map("minimum_quantity")
  maximumQuantity Int? @map("maximum_quantity")
  startsAt DateTime? @map("starts_at") @db.Date
  endsAt DateTime? @map("ends_at") @db.Date
  autoClose Boolean @default(false) @map("auto_close")
  closable Boolean @default(true)
  pausable Boolean @default(true)
  renewable Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items PlanItem[]
  prices PlanPrice[]
  subscriptions Subscription[]
  @@unique([organizationId, planCode])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@map("plans")
}

model PlanItem {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  planId String @map("plan_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  quantity Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan Plan @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Restrict)
  product Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, planId])
  @@map("plan_items")
}

model PlanPrice {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  planId String @map("plan_id") @db.Uuid
  currencyCode String @map("currency_code") @db.Char(3)
  billingPeriod BillingPeriod @map("billing_period")
  amount Decimal @db.Decimal(19, 4)
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  status PlanPriceStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan Plan @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, planId, currencyCode, billingPeriod, effectiveFrom])
  @@map("plan_prices")
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  subscriptionNumber String @map("subscription_number") @db.VarChar(64)
  customerId String @map("customer_id") @db.Uuid
  planId String @map("plan_id") @db.Uuid
  status SubscriptionStatus @default(DRAFT)
  startDate DateTime @map("start_date") @db.Date
  expirationDate DateTime? @map("expiration_date") @db.Date
  billingStartDate DateTime @map("billing_start_date") @db.Date
  currencyCode String @map("currency_code") @db.Char(3)
  paymentTerms String? @map("payment_terms") @db.VarChar(100)
  autoRenew Boolean @default(true) @map("auto_renew")
  currentPeriodStart DateTime? @map("current_period_start") @db.Date
  currentPeriodEnd DateTime? @map("current_period_end") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer Customer @relation(fields:[organizationId,customerId],references:[organizationId,id],onDelete:Restrict)
  plan Plan @relation(fields:[organizationId,planId],references:[organizationId,id],onDelete:Restrict)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  items SubscriptionItem[]
  events SubscriptionEvent[]
  amendments SubscriptionAmendment[]
  @@unique([organizationId,subscriptionNumber])
  @@unique([organizationId,id])
  @@index([organizationId,status,createdAt])
  @@map("subscriptions")
}

model SubscriptionItem {
  id String @id @default(uuid()) @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  descriptionSnapshot String @map("description_snapshot") @db.VarChar(2000)
  quantity Int
  unitPrice Decimal @map("unit_price") @db.Decimal(19,4)
  currencyCode String @map("currency_code") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  subscription Subscription @relation(fields:[subscriptionId],references:[id],onDelete:Restrict)
  @@index([subscriptionId])
  @@map("subscription_items")
}

model SubscriptionEvent {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 subscriptionId String @map("subscription_id") @db.Uuid
 eventType String @map("event_type") @db.VarChar(64)
 occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
 actorUserId String? @map("actor_user_id") @db.Uuid
 metadata Json?
 subscription Subscription @relation(fields:[subscriptionId],references:[id],onDelete:Restrict)
 @@index([organizationId,subscriptionId,occurredAt])
 @@map("subscription_events")
}

model SubscriptionAmendment {
 id String @id @default(uuid()) @db.Uuid
 subscriptionId String @map("subscription_id") @db.Uuid
 amendmentType SubscriptionAmendmentType @map("amendment_type")
 effectiveAt DateTime @map("effective_at") @db.Timestamptz(6)
 reason String? @db.VarChar(500)
 beforeSnapshot Json @map("before_snapshot")
 afterSnapshot Json @map("after_snapshot")
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 subscription Subscription @relation(fields:[subscriptionId],references:[id],onDelete:Restrict)
 @@index([subscriptionId,effectiveAt])
 @@map("subscription_amendments")
}

model Quotation {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 quotationNumber String @map("quotation_number") @db.VarChar(64)
 customerId String @map("customer_id") @db.Uuid
 status QuotationStatus @default(DRAFT)
 issueDate DateTime? @map("issue_date") @db.Date
 validUntil DateTime @map("valid_until") @db.Date
 currencyCode String @map("currency_code") @db.Char(3)
 subtotal Decimal @default(0) @db.Decimal(19,4)
 grandTotal Decimal @default(0) @map("grand_total") @db.Decimal(19,4)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 customer Customer @relation(fields:[organizationId,customerId],references:[organizationId,id],onDelete:Restrict)
 items QuotationItem[]
 @@unique([organizationId,quotationNumber])
 @@index([organizationId,status,createdAt])
 @@map("quotations")
}
model QuotationItem {
 id String @id @default(uuid()) @db.Uuid
 quotationId String @map("quotation_id") @db.Uuid
 description String @db.VarChar(2000)
 quantity Int
 unitPrice Decimal @map("unit_price") @db.Decimal(19,4)
 lineTotal Decimal @map("line_total") @db.Decimal(19,4)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 quotation Quotation @relation(fields:[quotationId],references:[id],onDelete:Restrict)
 @@index([quotationId])
 @@map("quotation_items")
}

model Invoice {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 invoiceNumber String @map("invoice_number") @db.VarChar(64)
 customerId String @map("customer_id") @db.Uuid
 subscriptionId String? @map("subscription_id") @db.Uuid
 status InvoiceStatus @default(DRAFT)
 currencyCode String @map("currency_code") @db.Char(3)
 issueDate DateTime @map("issue_date") @db.Date
 dueDate DateTime @map("due_date") @db.Date
 subtotal Decimal @default(0) @db.Decimal(19,4)
 discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(19,4)
 taxTotal Decimal @default(0) @map("tax_total") @db.Decimal(19,4)
 grandTotal Decimal @default(0) @map("grand_total") @db.Decimal(19,4)
 finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(6)
 voidedAt DateTime? @map("voided_at") @db.Timestamptz(6)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 customer Customer @relation(fields:[organizationId,customerId],references:[organizationId,id],onDelete:Restrict)
 items InvoiceItem[]
 payments Payment[]
 refunds Refund[]
 @@unique([organizationId,invoiceNumber])
 @@index([organizationId,status,dueDate])
 @@map("invoices")
}

model Payment {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 paymentNumber String @map("payment_number") @db.VarChar(64)
 invoiceId String @map("invoice_id") @db.Uuid
 amount Decimal @db.Decimal(19,4)
 currencyCode String @map("currency_code") @db.Char(3)
 method PaymentMethod
 status PaymentStatus @default(SUCCEEDED)
 reference String? @db.VarChar(255)
 idempotencyKey String @map("idempotency_key") @db.VarChar(128)
 notes String? @db.VarChar(2000)
 receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
 refunds Refund[]
 @@unique([organizationId,paymentNumber])
 @@unique([organizationId,idempotencyKey])
 @@index([organizationId,invoiceId,status,receivedAt])
 @@map("payments")
}

model Refund {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 refundNumber String @map("refund_number") @db.VarChar(64)
 invoiceId String @map("invoice_id") @db.Uuid
