{
  "name": "@subscription-management/database",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "validate": "dotenv -e ../../.env.local -- prisma validate --schema prisma/schema.prisma",
    "generate": "dotenv -e ../../.env.local -- prisma generate --schema prisma/schema.prisma",
    "migrate:dev": "dotenv -e ../../.env.local -- prisma migrate dev --schema prisma/schema.prisma",
    "migrate:status": "dotenv -e ../../.env.local -- prisma migrate status --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.19.0"
  }
}
